# Local default:
#   cp .env.example .env
#   docker compose up --build -d

# Use 8080 locally so it does not conflict with macOS/system web services.
# On the VPS, set this to 80.
FRONTEND_PORT=8080

# Replace this before running on the VPS.
JWT_SECRET=replace-with-a-long-random-secret

# Local Docker URL:
CORS_ORIGINS=http://localhost:8080,http://localhost

# VPS example:
# FRONTEND_PORT=80
# CORS_ORIGINS=https://assetflow.outmazed.com,http://assetflow.outmazed.com
